{
  "id": "agent-001",
  "name": "NetworkHealthAgent",
  "type": "agent",
  "version": "1.0.0",
  "description": "Agent for monitoring and detecting anomalies in network KPIs",

  "framework": {
    "agentFramework": "langgraph",
    "orchestration": "state-machine"
  },

  "entryPoint": "src/main.py",
  "runtime": "python3.10",

  "capabilities": [
    "metric_collection",
    "anomaly_detection",
    "root_cause_analysis"
  ],

  "dependencies": [
    "langgraph",
    "numpy",
    "requests"
  ],

  "integration": {
    "mcp": {
      "requiredServers": [
        {
          "name": "prometheus-mcp",
          "protocol": "http-stream"
        }
      ],
      "supportedProtocols": ["http-stream"]
    },
    "tools": [
      "metric-fetcher",
      "alert-generator"
    ]
  },

  "owner": "team-network-ai"
}